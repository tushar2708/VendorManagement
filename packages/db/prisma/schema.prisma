generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserTier {
  EXECUTIVE
  LEADERSHIP
}

enum UserRole {
  BUYER
  VENDOR
  ADMIN
}

enum VendorType {
  PRODUCTION_PART
  INDIRECT_SERVICES
}

enum RequestProcess {
  RFQ
  NOMINATION
  DIRECT
}

enum CandidateSource {
  MANUAL
  DIRECTORY
}

enum InviteStatus {
  PENDING
  INVITED
  OPENED
  REGISTERED
  EXPIRED
}

enum ApprovalStage {
  FINANCIAL_CRIME
  COMPLIANCE
  LEGAL
  IT_INFOSEC
  TAX
  PROCUREMENT
  DATA_PRIVACY
  BUSINESS_OWNER
}

enum SlaRisk {
  ON_TRACK
  AT_RISK
  OVERDUE
}

enum RequirementStage {
  DRAFT
  CANDIDATES_SELECTED
  INVITES_SENT
  IN_PROGRESS
  CLOSED
}

enum LinkState {
  INVITED
  PREQUAL_IN_PROGRESS
  PREQUAL_SUBMITTED
  PREQUAL_UNDER_REVIEW
  PREQUAL_CLEARED
  AWARDED
  FULL_IN_PROGRESS
  FULL_SUBMITTED
  FULL_UNDER_REVIEW
  CONTRACTS_IN_PROGRESS
  APPROVED
  ERP_SYNCING
  ONBOARDED
  REJECTED
  ON_HOLD
  WITHDRAWN
  ERP_FAILED
  EXPIRED
}

enum LinkStage {
  PREQUAL
  FULL
}

enum ActorSide {
  VENDOR
  BUYER
  SYSTEM
}

enum PartySide {
  VENDOR
  BUYER
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
}

enum ContractType {
  NDA
  MSA
  QUALITY_AGREEMENT
  SUPPLY_AGREEMENT
  PRICING_AGREEMENT
  DATA_PROCESSING
}

enum ContractState {
  DRAFT_PENDING
  DRAFT_UPLOADED
  VENDOR_REVIEW
  CHANGES_REQUESTED
  REVISED
  AGREED
  AWAITING_SIGNATURES
  PARTIALLY_EXECUTED
  EXECUTED
}

enum ContractVersionKind {
  DRAFT
  REVISED
  VENDOR_SIGNED
  BUYER_SIGNED
}

enum ReviewTaskStatus {
  PENDING
  IN_PROGRESS
  INFORMATION_REQUIRED
  APPROVED
  EDD_COMPLETE
  CHANGES_REQUESTED
}

enum ApprovalDecisionType {
  APPROVED
  CHANGES_REQUESTED
}

enum BuyerRole {
  OWNER
  QUALITY
  FINANCE
  TAX
  LEGAL
}

enum VerificationStatus {
  RUNNING
  PASSED
  FAILED
  NEEDS_REVIEW
  ACCEPTED
  REJECTED
}

enum VerificationCheckType {
  PAN
  GST
  UDYAM
  PENNY_DROP
  GST_FILINGS
}

enum DocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BadgeState {
  VERIFIED
  LISTED
  STALE
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(BUYER)
  tier          UserTier  @default(EXECUTIVE)
  buyerOrgId    String?
  vendorOrgId   String?
  buyerRole     BuyerRole?
  mobileNumber        String?
  mobileVerifiedAt    DateTime?
  mobileOtp           String?
  mobileOtpExpiresAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  createdRequests     VendorRequest[]    @relation("RequestCreator")
  buyerOrg            BuyerOrg?          @relation("BuyerUsers", fields: [buyerOrgId], references: [id])
  vendorOrg           VendorOrg?         @relation("VendorUsers", fields: [vendorOrgId], references: [id])
  reviewTasks         ReviewTask[]       @relation("ReviewTaskAssignee")
  approvalDecisions   ApprovalDecision[] @relation("DecisionMaker")
  vendorLinks         VendorBuyerLink[]  @relation("LinkUsers")
  capturedQuotations  Quotation[]        @relation("QuotationCapturer")
  notifications       Notification[]

  @@index([buyerOrgId])
  @@index([vendorOrgId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model BuyerOrg {
  id        String   @id @default(cuid())
  legalName String
  gstId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]             @relation("BuyerUsers")
  vendorRequests     VendorRequest[]    @relation("BuyerOrgRequests")
  candidates         RequestCandidate[] @relation("CandidateBuyerOrg")
  vendorInvitations  VendorInvitation[]
  vendorLinks        VendorBuyerLink[]  @relation("BuyerOrgLinks")

  @@index([gstId])
}

model VendorOrg {
  id           String   @id @default(cuid())
  legalName    String
  contactEmail String
  pan          String?
  gstin        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users       User[]             @relation("VendorUsers")
  vendorLinks VendorBuyerLink[]  @relation("VendorOrgLinks")
}

model DirectoryVendor {
  id              String   @id @default(cuid())
  legalName       String
  contactEmail    String   @unique
  pan             String?
  primaryGstin    String?
  city            String?
  state           String?
  processTags     String[] @default([])
  certificationTags String[] @default([])
  badgeState      BadgeState @default(LISTED)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  candidates        RequestCandidate[]
  quotations        Quotation[]

  @@index([contactEmail])
  @@index([primaryGstin])
}

model VendorRequest {
  id                    String            @id @default(cuid())
  requestNumber         String            @unique
  stage                 RequirementStage  @default(DRAFT)
  title                 String?
  category              String
  process               RequestProcess
  vendorType            VendorType
  businessJustification String?
  notes                 String?
  processCategories     String[]          @default([])
  plantLocation         String?
  targetAwardDate       DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  createdById           String
  createdBy             User              @relation("RequestCreator", fields: [createdById], references: [id])
  buyerOrgId            String
  buyerOrg              BuyerOrg          @relation("BuyerOrgRequests", fields: [buyerOrgId], references: [id])

  candidates            RequestCandidate[]
  invitations           VendorInvitation[]
  links                 VendorBuyerLink[]
  scoringCriteria       ScoringCriterion[]
  quotations            Quotation[]

  @@index([createdById])
  @@index([stage])
  @@index([requestNumber])
  @@index([buyerOrgId])
}

model RequestCandidate {
  id              String           @id @default(cuid())
  source          CandidateSource  @default(DIRECTORY)
  legalName       String?
  contactEmail    String?
  contactPhone    String?
  pan             String?
  gstin           String?
  city            String?
  state           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  requestId       String
  request         VendorRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          DirectoryVendor  @relation(fields: [vendorId], references: [id])
  buyerOrgId      String
  buyerOrg        BuyerOrg         @relation("CandidateBuyerOrg", fields: [buyerOrgId], references: [id])
  link            VendorBuyerLink?
  invitation      VendorInvitation?

  @@unique([requestId, vendorId])
  @@index([requestId])
  @@index([vendorId])
  @@index([buyerOrgId])
}

model VendorInvitation {
  id              String        @id @default(cuid())
  token           String        @unique @default(cuid())
  tokenHash       String?       @unique
  magicTokenPlain String?
  email           String?
  status          InviteStatus  @default(PENDING)
  expiresAt       DateTime
  remindersSent   Int           @default(0)
  lastReminderAt  DateTime?
  openedAt        DateTime?
  registeredAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  requestId       String
  request         VendorRequest @relation(fields: [requestId], references: [id])
  buyerOrgId      String
  buyerOrg        BuyerOrg      @relation(fields: [buyerOrgId], references: [id])
  candidateId     String?       @unique
  candidate       RequestCandidate? @relation(fields: [candidateId], references: [id])

  @@index([token])
  @@index([tokenHash])
  @@index([requestId])
  @@index([buyerOrgId])
}

model VendorBuyerLink {
  id                String      @id @default(cuid())
  candidateId       String      @unique
  requestId         String
  buyerOrgId        String
  vendorUserId      String?
  vendorOrgId       String?
  state             LinkState   @default(INVITED)
  stage             LinkStage?
  prequalScore      Int?
  awardedAt         DateTime?
  onboardedAt       DateTime?
  erpVendorCode     String?
  currentStateSince DateTime    @default(now())
  createdAt         DateTime    @default(now())

  candidate          RequestCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requirement        VendorRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  buyerOrg           BuyerOrg         @relation("BuyerOrgLinks", fields: [buyerOrgId], references: [id])
  vendorUser         User?            @relation("LinkUsers", fields: [vendorUserId], references: [id], onDelete: SetNull)
  vendorOrg          VendorOrg?       @relation("VendorOrgLinks", fields: [vendorOrgId], references: [id])

  events             LinkEvent[]
  submissions        Submission[]
  fieldValues        FieldValue[]
  documents          Document[]
  verificationChecks VerificationCheck[]
  reviewTasks        ReviewTask[]
  approvalDecisions  ApprovalDecision[]
  contracts          Contract[]
  contractVersions   ContractVersion[]
  contractComments   ContractComment[]

  @@index([requestId])
  @@index([buyerOrgId])
  @@index([vendorUserId])
}

model LinkEvent {
  id          String      @id @default(cuid())
  linkId      String
  fromState   LinkState?
  toState     LinkState
  actorType   ActorSide
  actorId     String?
  side        ActorSide
  note        String?
  occurredAt  DateTime    @default(now())

  link        VendorBuyerLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
}

model Submission {
  id                String            @id @default(cuid())
  linkId            String
  stage             LinkStage
  status            SubmissionStatus  @default(IN_PROGRESS)
  submittedAt       DateTime?
  resolvedChecklist Json?
  createdAt         DateTime          @default(now())

  link              VendorBuyerLink   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  fieldValues       FieldValue[]
  documents         Document[]

  @@unique([linkId, stage])
  @@index([linkId])
}

model FieldValue {
  id            String      @id @default(cuid())
  submissionId  String
  linkId        String
  fieldKey      String
  value         String?
  source        String?
  updatedAt     DateTime    @updatedAt

  submission    Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  link          VendorBuyerLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fieldKey])
  @@index([linkId])
  @@index([submissionId])
}

model FileBlob {
  id        String    @id @default(cuid())
  data      String
  sha256    String?
  createdAt DateTime  @default(now())

  documents          Document[]
  contractVersions   ContractVersion[]
  contractComments   ContractComment[]
}

model VerificationCheck {
  id            String             @id @default(cuid())
  checkType     VerificationCheckType
  subjectValue  String
  status        VerificationStatus @default(RUNNING)
  matchScore    Int?
  detail        Json?
  ranAt         DateTime?
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  linkId        String
  link          VendorBuyerLink    @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, checkType])
  @@index([linkId])
}

model Document {
  id              String           @id @default(cuid())
  checklistItemKey String?
  fileName        String
  mimeType        String
  sizeBytes       Int
  status          DocumentStatus   @default(PENDING)
  version         Int              @default(1)
  uploadedAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rejectionReason String?
  submissionId    String?
  submission      Submission?      @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  linkId          String
  link            VendorBuyerLink  @relation(fields: [linkId], references: [id], onDelete: Cascade)
  fileBlobId      String
  fileBlob        FileBlob         @relation(fields: [fileBlobId], references: [id])
  supersedesDocumentId String?  @unique
  supersedesDocument Document?    @relation("DocumentSupersession", fields: [supersedesDocumentId], references: [id])
  supersededBy    Document?        @relation("DocumentSupersession")

  @@index([linkId])
  @@index([fileBlobId])
  @@index([checklistItemKey])
}

model SlaRule {
  id                    String        @id @default(cuid())
  stage                 ApprovalStage @unique
  slaDays               Int
  escalateAfterBreach   Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Contract {
  id                String           @id @default(cuid())
  contractType      ContractType
  state             ContractState    @default(DRAFT_PENDING)
  currentVersionId  String?          @unique
  linkId            String
  dispatchedAt      DateTime?
  executedAt        DateTime?
  createdAt         DateTime         @default(now())

  currentVersion    ContractVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  link              VendorBuyerLink  @relation(fields: [linkId], references: [id], onDelete: Cascade)
  versions          ContractVersion[] @relation("ContractVersions")
  comments          ContractComment[]

  @@unique([linkId, contractType])
  @@index([linkId])
}

model ContractVersion {
  id                  String              @id @default(cuid())
  contractId          String
  linkId              String
  versionNo           Int
  fileBlobId          String
  fileName            String
  uploadedBySide      PartySide
  kind                ContractVersionKind
  supersedesVersionId String?             @unique
  createdAt           DateTime            @default(now())

  contract            Contract            @relation("ContractVersions", fields: [contractId], references: [id], onDelete: Cascade)
  currentOf           Contract?           @relation("CurrentVersion")
  link                VendorBuyerLink     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  fileBlob            FileBlob            @relation(fields: [fileBlobId], references: [id])
  supersedes          ContractVersion?    @relation("VersionSupersede", fields: [supersedesVersionId], references: [id])
  supersededBy        ContractVersion[]   @relation("VersionSupersede")
  comments            ContractComment[]

  @@unique([contractId, versionNo])
  @@index([contractId])
  @@index([linkId])
}

model ContractComment {
  id                String          @id @default(cuid())
  body              String
  authorSide        PartySide
  contractVersionId String
  linkId            String
  fileBlobId        String?
  fileName          String?
  createdAt         DateTime        @default(now())

  contractVersion   ContractVersion @relation(fields: [contractVersionId], references: [id], onDelete: Cascade)
  link              VendorBuyerLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  contract          Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId        String
  fileBlob          FileBlob?       @relation(fields: [fileBlobId], references: [id])

  @@index([linkId])
  @@index([contractVersionId])
}

model ReviewTask {
  id              String            @id @default(cuid())
  linkId          String
  stage           ApprovalStage
  assignedUserId  String?
  status          ReviewTaskStatus  @default(PENDING)
  slaHours        Int?
  createdAt       DateTime          @default(now())

  link            VendorBuyerLink   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  assignedUser    User?             @relation("ReviewTaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  decisions       ApprovalDecision[]

  @@unique([linkId, stage])
  @@index([linkId])
}

model ApprovalDecision {
  id            String               @id @default(cuid())
  reviewTaskId  String
  linkId        String
  decision      ApprovalDecisionType
  comment       String?
  decidedById   String?
  decidedAt     DateTime             @default(now())

  reviewTask    ReviewTask           @relation(fields: [reviewTaskId], references: [id], onDelete: Cascade)
  link          VendorBuyerLink      @relation(fields: [linkId], references: [id], onDelete: Cascade)
  decidedBy     User?                @relation("DecisionMaker", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([linkId])
  @@index([reviewTaskId])
}

model ScoringCriterion {
  id              String        @id @default(cuid())
  name            String
  weight          Int           @default(0)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  requirementId   String
  requirement     VendorRequest @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, name])
  @@index([requirementId])
}

model Quotation {
  id              String        @id @default(cuid())
  unitPrice       Int
  toolingPerUnit  Int           @default(0)
  freightPerUnit  Int           @default(0)
  leadTimeDays    Int
  location        String?
  capacityNote    String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  requestId       String
  vendorId        String
  capturedById    String?

  request         VendorRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor          DirectoryVendor @relation(fields: [vendorId], references: [id])
  capturedBy      User?         @relation("QuotationCapturer", fields: [capturedById], references: [id], onDelete: SetNull)

  @@unique([requestId, vendorId])
  @@index([requestId])
  @@index([vendorId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String
  title       String
  body        String?
  vendorName  String?
  vendorId    String?
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}
