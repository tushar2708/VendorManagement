DATABASE_URL="postgresql://user:password@host.neon.tech/database?sslmode=require"
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001
APP_BASE_URL=http://localhost:5173
RESEND_API_KEY=
RESEND_FROM=onboarding@vendor.local
SEED_PASSWORD_HASH=
VITE_MIXPANEL_TOKEN=
MIXPANEL_TOKEN=
# Analytics is OFF unless these are exactly "true". Keep them unset/false in dev
# so local runs don't send events to the shared Mixpanel project; set to true in
# the deployed environment (and ideally point the dev token at a separate project).
VITE_ANALYTICS_ENABLED=false
ANALYTICS_ENABLED=false
