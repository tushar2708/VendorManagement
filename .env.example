# Copy this file to .env (local dev) and .env.prod (Railway deployment).
# See README.md for which values differ between local and production.

DATABASE_URL="postgresql://user:password@host.neon.tech/database?sslmode=require"
PORT=3001
# NODE_ENV: "development" in .env, "production" in .env.prod
NODE_ENV=development
# CORS_ORIGIN: localhost:5173 in .env, Railway URL in .env.prod
CORS_ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# BETTER_AUTH_URL: localhost:3001 in .env, Railway URL in .env.prod
BETTER_AUTH_URL=http://localhost:3001
# VITE_API_BASE_URL: localhost:3001 in .env, empty in .env.prod
VITE_API_BASE_URL=http://localhost:3001
# APP_BASE_URL: localhost:5173 in .env, Railway URL in .env.prod
APP_BASE_URL=http://localhost:5173
RESEND_API_KEY=
RESEND_FROM=onboarding@vendor.local
SEED_PASSWORD_HASH=
VITE_MIXPANEL_TOKEN=
MIXPANEL_TOKEN=
VITE_ANALYTICS_ENABLED=false
ANALYTICS_ENABLED=false
